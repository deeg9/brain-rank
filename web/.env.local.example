# Supabase - get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RunPod - get these from your RunPod dashboard
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id

# Upstash Redis - used for per-user burst rate limiting on POST /api/jobs
# Create a free Redis DB at https://console.upstash.com/ and copy the REST creds.
# If both are unset, the rate limiter short-circuits to allow-all (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog - product analytics. Create a project at https://posthog.com/ and copy
# the project's Public API Key (starts with phc_). Safe to expose on the client.
# POSTHOG_API_KEY is used by the server-side SDK; same public write key works.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
